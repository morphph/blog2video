 "topbarIndex": "[09/11]",
 "subtitles": [
  {
   "id": "sub-1",
   "localStart": 0,
   "localDuration": 1.626,
   "text": "但自动驾驶有代价。"
  },
  {
   "id": "sub-2",
   "localStart": 1.621,
   "localDuration": 7.225,
   "text": "你把写权限，交给了一个会犯错的 Agent——它能自动归档、移动、标记你的笔记。"
  },
  {
   "id": "sub-3",
   "localStart": 8.995,
   "localDuration": 6.634,
   "text": "这里有一条作者反复强调、也是全片最该记住的铁律：是钥匙，不是嘴皮子。"
  },
  {
   "id": "sub-4",
   "localStart": 15.799,
   "localDuration": 0.894,
   "text": "什么意思？"
  },
  {
   "id": "sub-5",
   "localStart": 16.693,
   "localDuration": 6.255,
   "text": "你对一个 Agent 说\"别删这个文件\"，那只是个许愿，不是安全设置。"
  },
  {
   "id": "sub-6",
   "localStart": 22.948,
   "localDuration": 5.719,
   "text": "只要它技术上能删、能发邮件，你就得假设：总有一天它真的会这么做。"
  },
  {
   "id": "sub-7",
   "localStart": 28.831,
   "localDuration": 10.915,
   "text": "真正的安全，不靠你的措辞，靠权限本身——能给只读，就别给写权限；能限定范围的钥匙，就别用一句话去约束它。"
  },
  {
   "id": "sub-8",
   "localStart": 39.746,
   "localDuration": 3.358,
   "text": "安全建在权限层，不建在嘴皮子上。"
  }
 ]
}