 "srcSlideHtml": "/home/ubuntu/blog2video/blog2video-output/smoke-wf1-07111012/slide_13.html",
 "topbarIndex": "[13/13]",
 "subtitles": [
  {
   "id": "sub-1",
   "localStart": 0.011,
   "localDuration": 2.245,
   "text": "现在你应该看清那个认知反转了。"
  },
  {
   "id": "sub-2",
   "localStart": 2.423,
   "localDuration": 7.153,
   "text": "我们通常以为的顺序是:先有一个改变世界的点子,然后去创业,然后为它学技术。"
  },
  {
   "id": "sub-3",
   "localStart": 9.576,
   "localDuration": 8.699,
   "text": "但真相是完全反过来的:先擅长技术,然后做项目,然后点子和联合创始人,会自己从项目里冒出来。"
  },
  {
   "id": "sub-4",
   "localStart": 18.443,
   "localDuration": 11.881,
   "text": "所以你以为创业是先有一个改变世界的点子——真相是,那些改变了世界的公司,几乎都始于一个,没打算改变任何东西的周末项目。"
  },
  {
   "id": "sub-5",
   "localStart": 30.467,
   "localDuration": 2.879,
   "text": "当然,这里得诚实地留一句代价。"
  },
  {
   "id": "sub-6",
   "localStart": 33.346,
   "localDuration": 8.445,
   "text": "这套说法讲的,只是创业光谱最极端的那一端,Google 那一端,它不适用于开一家理发店。"
  },
  {
   "id": "sub-7",
   "localStart": 41.951,
   "localDuration": 9.044,
   "text": "而且\"做项目,点子自然来\",是有幸存者偏差的——它是一个\"起点\",不是一张\"成功的保证书\"。"
  },
  {
   "id": "sub-8",
   "localStart": 50.995,
   "localDuration": 1.769,
   "text": "别把它听成成功学。"
  },
  {
   "id": "sub-9",
   "localStart": 52.931,
   "localDuration": 7.911,
   "text": "那么,如果你今年 15 岁,想创业,现在该做什么?那份清单短得惊人,只有两件事。"
  },
  {
   "id": "sub-10",
   "localStart": 60.995,
   "localDuration": 4.978,
   "text": "第一,擅长技术,而唯一的路是做你自己的项目。"
  },
  {
   "id": "sub-11",
   "localStart": 65.973,
   "localDuration": 8.146,
   "text": "第二,在学校尽量考好,进一所好大学,因为那里有你的联合创始人和你的点子。"
  },
  {
   "id": "sub-12",
   "localStart": 74.279,
   "localDuration": 3.702,
   "text": "翻译成一句话就是:造东西,把书念好。"
  },
  {
   "id": "sub-13",
   "localStart": 77.981,
   "localDuration": 2.467,
   "text": "就这么简单,也就这么难。"
  },
  {
   "id": "sub-14",
   "localStart": 80.615,
   "localDuration": 4.157,
   "text": "AI 世界很吵,精读一篇,胜过刷一百条。"
  },
  {
   "id": "sub-15",
   "localStart": 84.772,
   "localDuration": 1.455,
   "text": "我们下期再见。"
  }
 ]
}