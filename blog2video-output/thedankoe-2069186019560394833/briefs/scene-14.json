 "topbarIndex": "[14/27]",
 "subtitles": [
  {
   "id": "sub-1",
   "localStart": 0,
   "localDuration": 5.868,
   "text": "第三根支柱，是这封信里我觉得最硬的一段——一个三百美元的故事。"
  },
  {
   "id": "sub-2",
   "localStart": 6.003,
   "localDuration": 2.884,
   "text": "那是接到第一个网页设计客户的日子。"
  },
  {
   "id": "sub-3",
   "localStart": 9.027,
   "localDuration": 6.297,
   "text": "对方是一家本地的床垫公司，他们只想要一个地方，能让人看到他们的床垫。"
  },
  {
   "id": "sub-4",
   "localStart": 15.471,
   "localDuration": 0.996,
   "text": "就这么简单。"
  },
  {
   "id": "sub-5",
   "localStart": 16.467,
   "localDuration": 4.152,
   "text": "给的钱是三百美元，做的还是一个手写的、很烂的网站。"
  },
  {
   "id": "sub-6",
   "localStart": 20.763,
   "localDuration": 3.696,
   "text": "但就在那一刻，有个东西\"咔哒\"一声接通了。"
  },
  {
   "id": "sub-7",
   "localStart": 24.615,
   "localDuration": 10.941,
   "text": "我意识到，只要我能把刚才赚到这笔钱的这件事，重复、改进、再迭代——我就能慢慢拿回对自己生活和未来的掌控权。"
  },
  {
   "id": "sub-8",
   "localStart": 35.703,
   "localDuration": 2.965,
   "text": "那一刻，我变得\"不可雇佣\"了。"
  },
  {
   "id": "sub-9",
   "localStart": 38.835,
   "localDuration": 7.493,
   "text": "它在我心里种下一个很深的信念：我再也不会去接受一份工作了，我要为自己的生存负责。"
  }
 ]
}