 "srcSlideHtml": "/Users/yufanp/Desktop/Project/blog2video/blog2video-output/thedankoe-2069186019560394833/slide_27.html",
 "topbarIndex": "[27/27]",
 "subtitles": [
  {
   "id": "sub-1",
   "localStart": 0.007,
   "localDuration": 3.267,
   "text": "我们绕了一大圈，回到最开始那个翻转。"
  },
  {
   "id": "sub-2",
   "localStart": 3.427,
   "localDuration": 3.859,
   "text": "真正威胁你的，从来不是 AI 会不会做你的工作。"
  },
  {
   "id": "sub-3",
   "localStart": 7.423,
   "localDuration": 7.528,
   "text": "而是除了上班，你什么都不会——AI 只是按下了那个一直存在的\"依赖\"快进键。"
  },
  {
   "id": "sub-4",
   "localStart": 15.091,
   "localDuration": 2.965,
   "text": "而解药，也从来不是去反 AI。"
  },
  {
   "id": "sub-5",
   "localStart": 18.223,
   "localDuration": 5.275,
   "text": "是亲手做出一件属于你自己的东西，把自己变成那个\"不可雇佣\"的人。"
  },
  {
   "id": "sub-6",
   "localStart": 23.659,
   "localDuration": 2.28,
   "text": "记住那两条真正的分水岭。"
  },
  {
   "id": "sub-7",
   "localStart": 26.107,
   "localDuration": 5.868,
   "text": "第一条：能做出来，已经不值钱了；能让人在乎，才稀缺。"
  },
  {
   "id": "sub-8",
   "localStart": 32.119,
   "localDuration": 7.063,
   "text": "第二条：你改不掉某个行为，往往不是因为不够努力，而是因为你还没变成那个人。"
  },
  {
   "id": "sub-9",
   "localStart": 39.319,
   "localDuration": 2.582,
   "text": "行为改变，等于身份改变。"
  },
  {
   "id": "sub-10",
   "localStart": 42.055,
   "localDuration": 3.174,
   "text": "所以，别再纠结要不要怕 AI 了。"
  },
  {
   "id": "sub-11",
   "localStart": 45.367,
   "localDuration": 5.612,
   "text": "今晚就关掉标签页，开一个空白文档，定十五分钟，回答那六个问题。"
  },
  {
   "id": "sub-12",
   "localStart": 51.127,
   "localDuration": 4.114,
   "text": "然后明天，发出你那条只有你能写出来的内容。"
  },
  {
   "id": "sub-13",
   "localStart": 55.411,
   "localDuration": 4.672,
   "text": "第一版一定很烂，没关系——你没法改进一个还不存在的东西。"
  },
  {
   "id": "sub-14",
   "localStart": 60.235,
   "localDuration": 4.63,
   "text": "AI 世界很吵，精读一篇，胜过刷一百条。"
  },
  {
   "id": "sub-15",
   "localStart": 64.865,
   "localDuration": 1.621,
   "text": "我们下期再见。"
  }
 ]
}