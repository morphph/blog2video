{
  "name": "blog2video",
  "version": "1.0.0",
  "description": "Blog2Video auto-publish system for Xiaohongshu & Weixin Channels",
  "scripts": {
    "build": "tsc",
    "b2v": "node blog2video-content/cli.mjs",
    "b2v:smoke": "bash blog2video-content/smoke.sh",
    "scheduler": "node dist/scheduler.js",
    "login:xhs": "node dist/cookie-manager.js xiaohongshu",
    "login:weixin": "node dist/cookie-manager.js weixin",
    "publish:xhs": "node dist/publish-xiaohongshu.js",
    "publish:weixin": "node dist/publish-weixin.js",
    "watch": "node dist/queue-watcher.js",
    "watch:once": "node dist/queue-watcher.js",
    "cleanup": "node dist/cleanup.js",
    "draft:all": "node dist/batch-draft.js",
    "publish:xhs:draft": "node dist/publish-xiaohongshu.js --draft",
    "wechat:intake": "node dist/wechat-drive-intake.js",
    "wechat:intake:dry-run": "node dist/wechat-drive-intake.js --dry-run",
    "wechat:intake:init-log": "node dist/wechat-drive-intake.js --init-log"
  },
  "dependencies": {
    "openai": "^6.25.0",
    "playwright": "^1.50.0",
    "puppeteer-core": "^24.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
